{
  "name": "student-bugtracker",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Базовый интерфейс учебного трекера багов. Без API и базы данных.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "vite client --host 127.0.0.1 --port 3001 --strictPort",
    "build": "tsc --noEmit && vite build client --outDir ../dist --emptyOutDir"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
